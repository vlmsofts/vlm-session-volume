# ── Derived data (DB + rollup outputs; regenerable from the ICE records) ──
data/

# ── Python bytecode / caches ──
__pycache__/
*.py[cod]
.pytest_cache/

# ── Runtime logs ──
logs/

# Generated session cards. Point-in-time artifacts, not source: one session
# can produce several (provisional then final), and they are reproducible from
# the store at any time.
renders/

# ── Editor / OS scratch ──
*.bak
*.tmp
*.swp
*~
